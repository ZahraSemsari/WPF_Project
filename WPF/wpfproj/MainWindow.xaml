<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TaskManager.ViewModels"
        Title="Task Manager" Height="450" Width="800" Background="#FFCC80">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F44336" />
        </Style>
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF9800" />
        </Style>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="10">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Background="#FFEB3B">
                <StackPanel>
                    <Label Content="List Management" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <Label Content="List Name:" />
                    <TextBox Text="{Binding ListName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Add List" Click="AddListButton_Click"/>
                        <Button Content="Delete List" Click="DeleteListButton_Click" Style="{StaticResource DeleteButtonStyle}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Name" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Background="#8BC34A">
                <StackPanel>
                    <Label Content="Task Management" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <Label Content="Task Name:" />
                    <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    
                    <Label Content="Start Time:" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding TaskStartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                        <TextBox Text="{Binding TaskStartTime, StringFormat='{}{0:HH:mm}', UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <Label Content="End Time:" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding TaskEndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                        <TextBox Text="{Binding TaskEndTime, StringFormat='{}{0:HH:mm}', UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,0,10"/>
                    </StackPanel>
                    
                    <Label Content="Starred:" />
                    <CheckBox IsChecked="{Binding TaskStarred, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <Label Content="Checked:" />
                    <CheckBox IsChecked="{Binding TaskChecked, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    
                    <Button Content="Add Task" Click="AddTaskButton_Click"/>
                    
                    <ListBox ItemsSource="{Binding SelectedList.Tasks}" SelectedItem="{Binding SelectedTask}" Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="5">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:MM/dd/yyyy HH:mm}}" />
                                        <TextBlock Text="{Binding EndTime, StringFormat={}{0:MM/dd/yyyy HH:mm}}" />
                                        <CheckBox Content="Starred" IsChecked="{Binding Starred}" />
                                        <CheckBox Content="Checked" IsChecked="{Binding Checked}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Button Content="Delete Task" Click="DeleteTaskButton_Click" Style="{StaticResource DeleteButtonStyle}"/>
                    
                    <Label Content="Rename Task:" />
                    <TextBox Text="{Binding SelectedTask.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <Button Content="Edit Task" Click="RenameTaskButton_Click" Style="{StaticResource EditButtonStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
